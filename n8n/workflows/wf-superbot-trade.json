{
  "name": "SuperBot Trade",
  "nodes": [
    {
      "id": "node_webhook",
      "name": "SuperBot Trade",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "superbot-trade",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "webhookId": "superbot-trade-auto",
        "responseData": true,
        "options": {}
      },
      "webhookId": "superbot-trade-auto",
      "isActive": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "f6c95c38-1a39-49ec-9a5e-a4b0872af8bb",
          "name": "SuperBot Webhook Auth"
        }
      }
    },
    {
      "id": "node_http_request",
      "name": "Update Order Settlement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 0],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $credentials.url + '/rest/v1/orders?order_id=eq.' + $json.body.order_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"},
            {"name": "Prefer", "value": "return=representation"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.body.status, pnl_dollars: $json.body.pnl_dollars }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      },
      "isActive": true
    },
    {
      "id": "node_respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 0],
      "parameters": {
        "responseCode": "200",
        "responseBody": "={{ $json }}",
        "respondWith": "json",
        "options": {}
      }
    }
  ],
  "connections": {
    "SuperBot Trade": {
      "main": [[{"node": "Update Order Settlement", "type": "main", "index": 0}]]
    },
    "Update Order Settlement": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
  "settings": {},
  "active": true,
  "webhookId": "superbot-trade-auto"
}