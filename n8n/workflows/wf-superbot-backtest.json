{
  "name": "SuperBot Backtest",
  "nodes": [
    {
      "id": "node_webhook",
      "name": "SuperBot Backtest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "superbot-backtest",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "webhookId": "superbot-backtest-auto",
        "responseData": true,
        "options": {}
      },
      "webhookId": "superbot-backtest-auto",
      "isActive": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "f6c95c38-1a39-49ec-9a5e-a4b0872af8bb",
          "name": "SuperBot Webhook Auth"
        }
      }
    },
    {
      "id": "node_exec",
      "name": "Execute Python",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [300, 0],
      "parameters": {
        "command": "env PYTHONPATH=/opt/superbot /usr/bin/python3 /opt/superbot/backtest.py --quick --limit 50 --top 10 --jobs 2",
        "executeOnce": true
      }
    },
    {
      "id": "node_respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 0],
      "parameters": {
        "responseCode": "200",
        "responseBody": "={{ $json }}",
        "respondWith": "json",
        "options": {}
      }
    }
  ],
  "connections": {
    "SuperBot Backtest": {
      "main": [[{"node": "Execute Python", "type": "main", "index": 0}]]
    },
    "Execute Python": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
  "settings": {},
  "active": true,
  "webhookId": "superbot-backtest-auto"
}