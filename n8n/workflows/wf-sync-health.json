      }
    },
    {
      "id": "node_alert",
      "name": "Alert if SLO Breached",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [600, 0],
      "parameters": {
        "command": "env PYTHONPATH=/opt/superbot /usr/bin/python3 -c \"import sys; lag=float(sys.argv[1]) if len(sys.argv)>1 else 0; if lag > 5: from mempalace import mempalace_kg_add; import json; mempalace_kg_add('sync_health_breach', json.dumps({'lag_seconds': lag, 'slo_seconds': 5, 'ts': __import__('time').time()})); print(f'ALERT: sync lag {lag}s > 5s SLO')\"",
        "executeOnce": true
      }
    },
    {
      "id": "node_log",
      "name": "Log Lag Metric",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [900, 0],
