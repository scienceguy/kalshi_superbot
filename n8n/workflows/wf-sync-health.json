      "id": "node_check_lag",
      "name": "Check Sync Lag",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [300, 0],
      "parameters": {
        "command": "env PYTHONPATH=/opt/superbot /usr/bin/python3 -c \"from local_db import get_local_db; db=get_local_db(); lag=db.get_sync_lag_seconds(); print(f'sync_lag={lag}')\"",
