        "command": "env PYTHONPATH=/opt/superbot /usr/bin/python3 -c \"import sys; lag=float(sys.argv[1]) if len(sys.argv)>1 else 0; from mempalace import mempalace_kg_add; import json; mempalace_kg_add('sync_lag_p95', json.dumps({'lag_seconds': lag, 'ts': __import__('time').time()}))\"",
